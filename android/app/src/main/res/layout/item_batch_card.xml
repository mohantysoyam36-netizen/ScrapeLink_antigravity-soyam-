<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="10dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvItemIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="#E0F2F1"
            android:gravity="center"
            android:text="📱"
            android:textSize="26sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategoryTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="मोबाइल फोन (Smartphones)"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCpcbCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CPCB: ITEW15 • AI Conf: 94%"
                android:textColor="@color/primary_dark"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSyncBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☁️ SYNCED"
            android:textSize="11sp"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:background="#E8F5E9"
            android:textColor="@color/primary"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border"
        android:layout_marginVertical="10dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvWeightAndCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚖️ 4.5 Kg • 3 Units"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHandoverStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COLLECTED"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="#FFF3CD"
            android:textColor="#856404"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPassportBatchId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Passport ID: BATCH-8f2a... • 14 Sep, 14:30"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
